// CACSS Library — Prisma schema for specialty botanical society lending

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  LIBRARIAN
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  LAPSED
  HONORARY
}

enum ItemFormat {
  BOOK
  JOURNAL
  MAGAZINE
  DVD
  CONVENTION_GUIDE
  REFERENCE_MATERIAL
  YOUTH_BOOK
  MAP
  BOOKLET
  PHOTOCOPY
  ARCHIVAL_COLLECTION
}

enum BindingType {
  HARDCOVER
  PAPERBACK
  SPIRAL
  LOOSE_LEAF
  OTHER
}

enum LoanStatus {
  PENDING_RARE_APPROVAL
  ACTIVE
  RETURNED
}

enum ReservationStatus {
  WAITING
  NOTIFIED
  FULFILLED
  CANCELLED
}

enum AttachmentKind {
  COVER_IMAGE
  PDF_SCAN
  DIGITAL_ARCHIVE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CHECKOUT
  RETURN
  CONDITION_CHANGE
  IMPORT
}

enum NotificationType {
  DUE_SOON
  OVERDUE
  WAITLIST
  RARE_APPROVAL_REQUEST
  RARE_APPROVAL_RESULT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberProfile  MemberProfile?
  auditLogs      AuditLog[]
  notifications  Notification[]
  loansApproved  Loan[]             @relation("LoanApprover")
  conditionLogs  ItemConditionHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MemberProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  phone            String?
  membershipStatus MembershipStatus   @default(ACTIVE)
  favoriteTopics   String[]         @default([])
  notesInternal    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans         Loan[]
  reservations  Reservation[]
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelves ShelfLocation[]
  items   Item[]
}

model ShelfLocation {
  id        String   @id @default(cuid())
  branchId  String
  code      String
  label     String?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  copies ItemCopy[]

  @@unique([branchId, code])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  items    Item[]
}

model Author {
  id             String   @id @default(cuid())
  normalizedName String   @unique
  displayName    String
  createdAt      DateTime @default(now())

  items ItemAuthor[]
}

model ItemAuthor {
  itemId    String
  authorId  String
  sortOrder Int    @default(0)

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([itemId, authorId])
}

model Donor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  copies ItemCopy[]
}

/// Bibliographic / catalog record (work-level)
model Item {
  id                     String      @id @default(cuid())
  title                  String
  subtitle               String?
  publicationYear        Int?
  edition                String?
  publisher              String?
  isbn                   String?
  pages                  Int?
  bindingType            BindingType?
  format                 ItemFormat
  categoryId             String?
  branchId               String?
  language               String      @default("en")
  rarityScore            Int         @default(0)
  estimatedValue         Decimal?    @db.Decimal(12, 2)
  checkoutEligible       Boolean     @default(true)
  referenceOnly          Boolean     @default(false)
  signedEdition          Boolean     @default(false)
  outOfPrint             Boolean     @default(false)
  fragile                Boolean     @default(false)
  archival               Boolean     @default(false)
  doNotRemoveFromLibrary Boolean     @default(false)
  rareProtected          Boolean     @default(false)
  loanDaysDefault        Int         @default(21)
  loanDaysRare           Int         @default(7)
  requiresRareApproval   Boolean     @default(false)
  botanicalGenera        String[]    @default([])
  tags                   String[]    @default([])
  notes                  String?
  acquisitionNotes       String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  category    Category?    @relation(fields: [categoryId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  authors     ItemAuthor[]
  copies      ItemCopy[]
  attachments Attachment[]
  reservations Reservation[]
}

model ItemCopy {
  id               String    @id @default(cuid())
  itemId           String
  copyNumber       Int       @default(1)
  barcode          String?   @unique
  shelfLocationId  String?
  conditionNotes   String?
  damaged          Boolean   @default(false)
  missing          Boolean   @default(false)
  donorId          String?
  acquisitionDate  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  item           Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  shelfLocation  ShelfLocation?         @relation(fields: [shelfLocationId], references: [id])
  donor          Donor?                 @relation(fields: [donorId], references: [id])
  loans          Loan[]
  conditionLog   ItemConditionHistory[]
  attachments    Attachment[]
}

model Loan {
  id                     String    @id @default(cuid())
  memberProfileId        String
  itemCopyId             String
  checkedOutAt           DateTime  @default(now())
  dueDate                DateTime
  returnedAt             DateTime?
  status                 LoanStatus @default(ACTIVE)
  renewalCount           Int       @default(0)
  maxRenewals            Int       @default(2)
  approvedByUserId       String?
  dueDateAcknowledgedAt  DateTime?
  notes                  String?
  reportedDamageOnReturn String?

  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  itemCopy      ItemCopy      @relation(fields: [itemCopyId], references: [id], onDelete: Cascade)
  approvedBy    User?         @relation("LoanApprover", fields: [approvedByUserId], references: [id])
}

model Reservation {
  id              String             @id @default(cuid())
  memberProfileId String
  itemId          String
  status          ReservationStatus  @default(WAITING)
  createdAt       DateTime           @default(now())
  notifiedAt      DateTime?

  memberProfile MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([memberProfileId, itemId])
}

model ItemConditionHistory {
  id          String   @id @default(cuid())
  itemCopyId  String
  condition   String
  notes       String?
  recordedById String?
  createdAt   DateTime @default(now())

  itemCopy   ItemCopy @relation(fields: [itemCopyId], references: [id], onDelete: Cascade)
  recordedBy User? @relation(fields: [recordedById], references: [id])
}

model Attachment {
  id         String         @id @default(cuid())
  itemId     String?
  itemCopyId String?
  kind       AttachmentKind
  filename   String
  mimeType   String?
  storageKey String
  bytes      Int?
  createdAt  DateTime       @default(now())

  item     Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemCopy ItemCopy? @relation(fields: [itemCopyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  payload    Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  payload   Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
