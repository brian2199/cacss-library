# Database (PostgreSQL)
# Use 5433 when Docker maps db to host port 5433 (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cacss?schema=public"

# Auth.js / NextAuth — generate with `openssl rand -base64 32`
AUTH_SECRET=""
# Optional legacy alias
# NEXTAUTH_SECRET=""

# Used by middleware JWT checks & OAuth callbacks
AUTH_TRUST_HOST="true"

# Optional explicit URL (production)
# AUTH_URL="https://your-domain.example"

# Optional public URL for QR deep links when headers are missing (not usually needed)
# NEXT_PUBLIC_APP_URL="http://localhost:3001"
